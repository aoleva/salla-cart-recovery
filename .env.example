PORT=3000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
DEV_MODE=true
COOKIE_SECURE=false

# Salla Embedded App: use the SAME App ID of your existing Salla app.
SALLA_APP_ID=PUT_YOUR_EXISTING_SALLA_APP_ID_HERE

# Optional but recommended: add the same custom header in Salla Partner webhook settings.
# Header name defaults to x-cart-recovery-secret.
SALLA_WEBHOOK_SECRET=
SALLA_WEBHOOK_SECRET_HEADER=x-cart-recovery-secret

# Session / encryption. Replace all values before production.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
APP_ENCRYPTION_KEY=CHANGE_ME_TO_64_HEX_CHARS

# Private admin area used by you to assign an UltraMsg instance to a Salla merchant.
ADMIN_KEY=CHANGE_ME_ADMIN_KEY

# Recovery worker
RECOVERY_WORKER_INTERVAL_MS=15000
ULTRAMSG_TIMEOUT_MS=10000
